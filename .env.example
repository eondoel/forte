# Copia este archivo como ".env.local" y pega tu cadena de conexión de Neon.
# La encuentras en el dashboard de Neon -> tu proyecto -> "Connection string".
# Usa la cadena "Pooled connection" (incluye ?sslmode=require).
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/forte?sslmode=require"

# Token secreto para registrar caminatas desde el Atajo de Apple (Apple Watch / Salud).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WALK_API_TOKEN="pon_aqui_un_token_secreto_largo"
